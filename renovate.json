{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "develop"
  ],
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "automerge": true,
  "automergeType": "pr",
  "terraform": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "regex"
      ],
      "matchFileNames": [
        "iac/modules/gitlab/variables.tf"
      ],
      "matchStrings": [
        "variable \"helm_chart_version\"[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "gitlab",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://charts.gitlab.io",
      "groupName": "GitLab Helm chart"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "reviewers": [
        "engineers/infrastructure-engineers"
      ]
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchFileNames": [
        "iac/**"
      ],
      "groupName": "OpenTofu/Terraform",
      "reviewers": [
        "engineers/infrastructure-engineers"
      ]
    }
  ],
  "dependencyDashboard": true,
  "configMigration": true,
  "reviewersFromCodeOwners": true,
  "expandCodeOwnersGroups": true
}

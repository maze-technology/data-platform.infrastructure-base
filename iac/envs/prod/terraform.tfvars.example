# Example terraform.tfvars for prod environment
# Copy this to terraform.tfvars and customize as needed
# DO NOT commit terraform.tfvars with secrets

vpc_cidr = "10.0.0.0/16"

availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24", "10.0.12.0/24"]

kubernetes_version = "1.28"

# Secrets - provide via environment variables or secret manager
# letsencrypt_email = "admin@example.com"
# grafana_host      = "grafana.prod.example.com"
# argocd_host       = "argocd.prod.example.com"
# temporal_host     = "temporal.prod.example.com"


# terraform.tfvars.example — GitLab environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# USAGE:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with your values
#   tofu init && tofu plan && tofu apply
#
# SECRETS: Prefer environment variables over storing secrets in terraform.tfvars:
#   export TF_VAR_ovh_application_key="xxxx"
#   export TF_VAR_ovh_application_secret="xxxx"
#   export TF_VAR_ovh_consumer_key="xxxx"
#   export TF_VAR_wireguard_server_private_key="$(wg genkey)"
#   export TF_VAR_gitlab_root_password="YourStrongPassword123!"
#   export TF_VAR_backup_age_public_key="age1xxxx..."
#
# ⚠ NEVER commit terraform.tfvars to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── OVH API Credentials ────────────────────────────────────────────────────
# Create tokens at https://api.ovh.com/createToken/ with rights:
#   GET /me/sshKey
#   POST /me/sshKey
#   GET /dedicated/server/{serviceName}
#   POST /dedicated/server/{serviceName}/install/start
#   GET /dedicated/server/{serviceName}/install/status
ovh_endpoint           = "ovh-eu"
ovh_application_key    = "xxxxxxxxxxxxxxxxxxxx"   # REPLACE
ovh_application_secret = "xxxxxxxxxxxxxxxxxxxx"   # REPLACE
ovh_consumer_key       = "xxxxxxxxxxxxxxxxxxxx"   # REPLACE

# ── Server ─────────────────────────────────────────────────────────────────
# Find the service name in OVH Control Panel → Bare Metal Cloud → Dedicated Servers
# It looks like: ns123456.ip-1-2-3-4.eu
server_service_name = "ns123456.ip-1-2-3-4.eu"   # REPLACE
hostname            = "gitlab"
os_template         = "ubuntu2404-server_64"

# ── SSH ────────────────────────────────────────────────────────────────────
# Generate keys: ssh-keygen -t ed25519 -C "gitlab-server" -f ~/.ssh/gitlab-server
ssh_public_key       = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... gitlab-server"  # REPLACE
ssh_private_key_path = "~/.ssh/gitlab-server"  # REPLACE with path to private key
ssh_user             = "ubuntu"
admin_username       = "ubuntu"  # or a custom username e.g. "ops"

# ── WireGuard VPN ──────────────────────────────────────────────────────────
# Generate keys:
#   WG_PRIV=$(wg genkey)
#   WG_PUB=$(echo "$WG_PRIV" | wg pubkey)
#   echo "Private: $WG_PRIV"
#   echo "Public:  $WG_PUB"
wireguard_port               = 51820
wireguard_vpn_subnet         = "10.8.0.0/24"
wireguard_server_vpn_ip      = "10.8.0.1"
wireguard_server_private_key = "SERVER_PRIVATE_KEY_HERE"  # REPLACE — use env var instead
wireguard_server_public_key  = "SERVER_PUBLIC_KEY_HERE"   # REPLACE — derived from private key

# Operator client(s). Add one entry per developer/machine.
# Generate client keys on each device: wg genkey | tee /etc/wireguard/privatekey | wg pubkey > /etc/wireguard/publickey
wireguard_peers = [
  {
    name       = "ops-laptop"
    public_key = "CLIENT_PUBLIC_KEY_HERE"  # REPLACE
    vpn_ip     = "10.8.0.2"
  },
  # Add more peers as needed:
  # {
  #   name       = "ops-desktop"
  #   public_key = "ANOTHER_CLIENT_PUBLIC_KEY"
  #   vpn_ip     = "10.8.0.3"
  # },
]

# ── GitLab ─────────────────────────────────────────────────────────────────
gitlab_domain          = "gitlab.internal"
gitlab_registry_domain = "registry.gitlab.internal"
gitlab_root_password   = "CHANGE_ME_STRONG_PASSWORD_123!"  # REPLACE — min 12 chars
gitlab_version         = ""  # "" = install latest GitLab CE
gitlab_puma_workers    = 2   # 2 is good for ECO servers with ≤16GB RAM
gitlab_sidekiq_concurrency = 10

# ── Backups ────────────────────────────────────────────────────────────────
# Generate age key pair: age-keygen -o ~/.age/gitlab-backup-key.txt
# The file contains the private key. The public key line starts with "age1".
backup_age_public_key  = "age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # REPLACE
backup_retention_days  = 7
backup_cron_hour       = 2   # 2 AM UTC
backup_cron_minute     = 0

# S3 remote backup (optional). Recommended: OVH Object Storage (S3-compatible)
backup_s3_enabled    = false
backup_s3_bucket     = "maze-tech-gitlab-backups"
backup_s3_endpoint   = "https://s3.gra.io.cloud.ovh.net"
backup_s3_region     = "gra"
backup_s3_access_key = ""  # REPLACE if s3_enabled = true — use env var
backup_s3_secret_key = ""  # REPLACE if s3_enabled = true — use env var
